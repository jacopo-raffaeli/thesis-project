# LATEX
# text.usetex: True

# FONTS
font.family: serif
font.size: 10
axes.titlesize: 12
axes.labelsize: 11
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

# FIGURE
figure.figsize: 6.5, 4.0
# For thesis try also:
# figure.figsize: 6.5, 3.8
figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight

# LINES
lines.linewidth: 1.5
lines.markersize: 5

# AXES
axes.grid: True
grid.alpha: 0.3
grid.linestyle: --

axes.spines.top: False
axes.spines.right: False

# TICKS
xtick.direction: in
ytick.direction: in

# LEGEND
legend.frameon: False

